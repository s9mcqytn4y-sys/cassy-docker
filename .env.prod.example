# ==============================================================================
# Cassy by AzureDevID - Production Environment Template (.env.prod.example)
# Copy to /etc/cassy/prod.env on the VPS (chmod 600). NEVER commit real secrets.
# ==============================================================================

# 1. Core & Origins
APP_ENV=production
FRONTEND_URL=https://pos.abbdullaziz.online
ALLOWED_ORIGINS=https://pos.abbdullaziz.online
APP_PUBLIC_URL=https://pos.abbdullaziz.online
DEFAULT_STORE_SLUG=
EDGE_SUBNET=172.30.0.0/24
CLOUDFLARE_TUNNEL_TOKEN=replace-with-prod-cloudflare-tunnel-token
GUEST_SPLIT_ENABLED=false

# 2. PostgreSQL 18 Triple-Role (Production)
DB_NAME=cassy_prod
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=replace-with-strong-super-password
DB_MIGRATOR_USER=cassy_migrator
DB_MIGRATOR_PASSWORD=replace-with-strong-migrator-password
DB_APP_USER=cassy_app
DB_APP_PASSWORD=replace-with-strong-app-password
COMPOSE_DATABASE_URL=postgres://cassy_app:replace-with-strong-app-password@postgres:5432/cassy_prod?sslmode=disable
COMPOSE_DATABASE_MIGRATION_URL=postgres://cassy_migrator:replace-with-strong-migrator-password@postgres:5432/cassy_prod?sslmode=disable

# 3. Auth & Envelope Encryption
JWT_SECRET_KEY=CHANGEME_PROD_JWT_SECRET
JWT_EXPIRED_HOURS=24
CREDENTIAL_ENCRYPTION_KEY=CHANGEME_PROD_ENCRYPTION_KEY
PLATFORM_ADMIN_API_KEY=CHANGEME_PLATFORM_ADMIN_KEY

# 4. Midtrans Production (Core API Direct - Live)
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_MERCHANT_ID=G000000000
MIDTRANS_SERVER_KEY=Mid-server-prod-placeholder
MIDTRANS_CLIENT_KEY=Mid-client-prod-placeholder
MIDTRANS_QRIS_ACQUIRER=gopay

# 5. Cloud Messaging Profile - Production
# Email: Hostinger SMTP implicit TLS on port 465 (required in production)
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=noreply@abbdullaziz.online
SMTP_PASSWORD=replace-with-hostinger-mailbox-password
EMAIL_FROM_ADDRESS=noreply@abbdullaziz.online
EMAIL_FROM_NAME=Cassy by AzureDevID

# SMS: webhook (Fonnte/gateway) or fail-closed disabled (log is rejected in prod)
SMS_DRIVER=disabled
SMS_EMAIL_TO=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# WhatsApp: Meta Cloud API v21.0 (bridge is refused in production)
WHATSAPP_DRIVER=cloud
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-permanent-access-token
WHATSAPP_RECEIPT_TEMPLATE=struk_digital
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=

# 6. Cloudflare R2 Triple-Bucket Storage & Backups
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=CHANGEME_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=CHANGEME_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=CHANGEME_R2_SECRET_KEY
R2_BUCKET_NAME=cassy-media
R2_PRIVATE_BUCKET_NAME=cassy-private-media
R2_PUBLIC_URL=https://cdn.abbdullaziz.online

# 7. Observability (Sentry & Grafana Cloud)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
CASSY_CLIENT=cassy-prod
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=
