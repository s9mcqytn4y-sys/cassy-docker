# ==============================================================================
# Cassy by AzureDevID - Demo / Staging Environment Template (.env.demo.example)
# Copy to .env.demo on your workstation or staging host. NEVER commit .env.demo.
# ==============================================================================

# 1. Core & Origins
APP_ENV=staging
DEMO_HTTP_PORT=8088
FRONTEND_URL=https://demo.abbdullaziz.online
ALLOWED_ORIGINS=https://demo.abbdullaziz.online
APP_PUBLIC_URL=https://demo.abbdullaziz.online
DEFAULT_STORE_SLUG=central-cafe
DEMO_EDGE_SUBNET=172.29.10.0/24
CLOUDFLARE_TUNNEL_TOKEN=replace-with-demo-cloudflare-tunnel-token

# 2. PostgreSQL 18 Triple-Role (Demo)
DB_NAME=cassy_demo
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=replace-with-demo-super-password
DB_MIGRATOR_USER=cassy_migrator
DB_MIGRATOR_PASSWORD=replace-with-demo-migrator-password
DB_APP_USER=cassy_app
DB_APP_PASSWORD=replace-with-demo-app-password

# 3. Auth, Demo PINs & Encryption (Required by DockerComposeDemo.yml)
JWT_SECRET_KEY=CHANGEME_DEMO_JWT_SECRET
CREDENTIAL_ENCRYPTION_KEY=CHANGEME_DEMO_ENCRYPTION_KEY
DEMO_OWNER_PIN=123456
DEMO_STAFF_PIN=654321
PLATFORM_ADMIN_API_KEY=CHANGEME_PLATFORM_ADMIN_KEY

# 4. Midtrans Sandbox (Always Sandbox in Demo/Staging)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=G000000000
MIDTRANS_SERVER_KEY=SB-Mid-server-demo-placeholder
MIDTRANS_CLIENT_KEY=SB-Mid-client-demo-placeholder
MIDTRANS_QRIS_ACQUIRER=gopay
PLATFORM_MIDTRANS_IS_PRODUCTION=false
PLATFORM_MIDTRANS_SERVER_KEY=SB-Mid-server-platform-placeholder
PLATFORM_MIDTRANS_CLIENT_KEY=SB-Mid-client-platform-placeholder

# 5. Cloud Messaging Profile - Demo / Local
# Email: Gmail SMTP STARTTLS on port 587 (requires Google App Password)
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=your-demo-gmail@gmail.com
SMTP_PASSWORD=replace-with-16-char-google-app-password
EMAIL_FROM_ADDRESS=your-demo-gmail@gmail.com
EMAIL_FROM_NAME=Cassy Demo

# SMS: log is refused in staging; use email bridge, webhook, or disabled
SMS_DRIVER=email
SMS_EMAIL_TO=owner@abbdullaziz.online
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# WhatsApp: bridge (cmd/wa-bridge via whatsmeow, demo/dev only) or disabled
WHATSAPP_DRIVER=disabled
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECEIPT_TEMPLATE=struk_digital
WHATSAPP_TEMPLATE_LANGUAGE=id

# 6. Storage & Observability
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cassy-media
R2_PRIVATE_BUCKET_NAME=cassy-private-media
R2_PUBLIC_URL=https://cdn.abbdullaziz.online
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
